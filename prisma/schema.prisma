generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  password           String
  primaryGoal        String?
  levelCrossFit      String?
  levelWorkout       String?
  levelWeightLifting String?
  levelCardio        String?
  levelRunning       String?
  weight             Float?
  height             Float?
  age                Int?
  geminiKey          String?
  createdAt          DateTime    @default(now())
  roles              String[]    @default(["trainee"])
  inviteCode         String?     @unique
  shareRecovery      Boolean     @default(false)
  shareFeeling       Boolean     @default(false)
  shareBodyStats     Boolean     @default(false)
  days               Day[]
  maxRecords         MaxRecord[]
  aiMessages         AIMessage[]
  trainerClients     TrainerClient[] @relation("TrainerOf")
  clientLinks        TrainerClient[] @relation("ClientOf")
  programs                   Program[]
  assignmentsAsTrainee       ProgramAssignment[] @relation("AssignmentTrainee")
  assignmentsAssignedByMe    ProgramAssignment[] @relation("AssignmentAssignedBy")
  assignmentsCompletedByMe   ProgramAssignment[] @relation("AssignmentCompletedBy")
  sessionFeedback            SessionFeedback[]
  notifications              Notification[]
}

model TrainerClient {
  id        String    @id @default(cuid())
  trainerId String
  trainer   User      @relation("TrainerOf", fields: [trainerId], references: [id])
  traineeId String
  trainee   User      @relation("ClientOf", fields: [traineeId], references: [id])
  status    String    @default("pending") // "pending" | "active" | "ended"
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@unique([trainerId, traineeId])
}

model AIMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

model Day {
  id           String        @id @default(cuid())
  date         String
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  sessions     Session[]
  recovery     Recovery?
  aiSuggestion AISuggestion?
  postWorkoutFeeling String?
  postWorkoutComment  String?
  createdAt    DateTime      @default(now())

  @@unique([userId, date])
}

model Session {
  id           String   @id @default(cuid())
  dayId        String
  day          Day      @relation(fields: [dayId], references: [id])
  type         String
  name         String
  desc         String?
  result       String?
  scale        String?
  notes        String?
  rounds       String?
  resultRounds String?
  planSets     String?   // planning targets (JSON)
  aiNote       String?
  sets         Set[]     // result sets (actual performance)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  createdById  String?          // who added it; nullable — backfilled from day.userId, no auth-derived creator yet
  source       String   @default("self")
  assignmentId String?
  assignment   ProgramAssignment? @relation(fields: [assignmentId], references: [id])
  isRestDay    Boolean  @default(false)
  feedback     SessionFeedback?
  feeling        String?  // "crushed" | "strong" | "good" | "okay" | "tired"
  feelingComment String?
}

model SessionFeedback {
  id        String   @id @default(cuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id])
  trainerId String
  trainer   User     @relation(fields: [trainerId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String    // "feedback" | "assignment" | "connection_request" | "connection_accepted"
  refId     String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Program {
  id          String   @id @default(cuid())
  trainerId   String
  trainer     User     @relation(fields: [trainerId], references: [id])
  name        String
  description String?
  status      String   @default("draft")     // "draft" | "published" | "archived"
  accessMode  String   @default("assigned")  // "assigned" | "open"
  createdAt   DateTime @default(now())
  weeks       ProgramWeek[]
  assignments ProgramAssignment[]
}

model ProgramWeek {
  id         String       @id @default(cuid())
  programId  String
  program    Program      @relation(fields: [programId], references: [id])
  weekNumber Int
  days       ProgramDay[]

  @@unique([programId, weekNumber])
}

model ProgramDay {
  id        String   @id @default(cuid())
  weekId    String
  week      ProgramWeek @relation(fields: [weekId], references: [id])
  dayIndex  Int      // 1=Mon..7=Sun
  isRestDay Boolean  @default(false)
  sessions  ProgramSession[]

  @@unique([weekId, dayIndex])
}

model ProgramSession {
  id                String     @id @default(cuid())
  dayId             String
  day               ProgramDay @relation(fields: [dayId], references: [id])
  type              String     // SessionType key — meaningless when the parent ProgramDay.isRestDay
  name              String
  desc              String?
  planSets          String?    // JSON: {setNumber,percentage,reps,notes}[]
  rounds            String?    // JSON: RoundEntry[]
  referenceMovement String?
  order             Int        @default(0)
}

model ProgramAssignment {
  id                   String    @id @default(cuid())
  programId            String
  program              Program   @relation(fields: [programId], references: [id])
  traineeId            String
  trainee              User      @relation("AssignmentTrainee", fields: [traineeId], references: [id])
  startDate            String
  startWeek            Int       @default(1)
  endWeek              Int?
  assignedById         String
  assignedBy           User      @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  previousAssignmentId String?
  previousAssignment   ProgramAssignment?  @relation("Reassignment", fields: [previousAssignmentId], references: [id])
  reassignments        ProgramAssignment[] @relation("Reassignment")
  status               String    @default("active") // "active" | "completed" | "cancelled"
  completedById        String?
  completedBy          User?     @relation("AssignmentCompletedBy", fields: [completedById], references: [id])
  assignedAt           DateTime  @default(now())
  completedAt          DateTime?
  generatedSessions    Session[]
}

model SessionType {
  key      String  @id          // immutable, matches SessionType union values in src/types/index.ts
  label    String
  color    String
  behavior String              // "sets" | "rounds" | "text"
  order    Int     @default(0)
  active   Boolean @default(true)
}

model Set {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  setNumber Int
  weight    Float?
  reps      Int?
  notes     String?
  createdAt DateTime @default(now())
}

model Recovery {
  id           String   @id @default(cuid())
  dayId        String   @unique
  day          Day      @relation(fields: [dayId], references: [id])
  energy       Int
  sore         String
  soreOther    String?
  sleepHours   Float?
  sleepQuality Int?
  notes        String?
  createdAt    DateTime @default(now())
}

model AISuggestion {
  id           String   @id @default(cuid())
  dayId        String   @unique
  day          Day      @relation(fields: [dayId], references: [id])
  summary      String
  perSession   String
  chips        String
  recoveryNote String?
  createdAt    DateTime @default(now())
}

model MaxRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  movement    String
  category    String   // "wl" | "workout" | "run"
  details     String?
  weight      Float?
  reps        Int?
  distance    Float?
  timeSeconds Int?
  notes       String?
  isExpected  Boolean  @default(false)
  date        String
  createdAt   DateTime @default(now())
}