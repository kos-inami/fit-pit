generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  password           String
  primaryGoal        String?
  levelCrossFit      String?
  levelWorkout       String?
  levelWeightLifting String?
  levelCardio        String?
  levelRunning       String?
  weight             Float?
  height             Float?
  age                Int?
  geminiKey          String?
  createdAt          DateTime    @default(now())
  roles              String[]    @default(["trainee"])
  inviteCode         String?     @unique
  shareRecovery      Boolean     @default(false)
  shareFeeling       Boolean     @default(false)
  shareBodyStats     Boolean     @default(false)
  days               Day[]
  maxRecords         MaxRecord[]
  aiMessages         AIMessage[]
  trainerClients     TrainerClient[] @relation("TrainerOf")
  clientLinks        TrainerClient[] @relation("ClientOf")
}

model TrainerClient {
  id        String    @id @default(cuid())
  trainerId String
  trainer   User      @relation("TrainerOf", fields: [trainerId], references: [id])
  traineeId String
  trainee   User      @relation("ClientOf", fields: [traineeId], references: [id])
  status    String    @default("pending") // "pending" | "active" | "ended"
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@unique([trainerId, traineeId])
}

model AIMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())
}

model Day {
  id           String        @id @default(cuid())
  date         String
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  sessions     Session[]
  recovery     Recovery?
  aiSuggestion AISuggestion?
  postWorkoutFeeling String?
  postWorkoutComment  String?
  createdAt    DateTime      @default(now())

  @@unique([userId, date])
}

model Session {
  id           String   @id @default(cuid())
  dayId        String
  day          Day      @relation(fields: [dayId], references: [id])
  type         String
  name         String
  desc         String?
  result       String?
  scale        String?
  notes        String?
  rounds       String?
  resultRounds String?
  planSets     String?   // planning targets (JSON)
  aiNote       String?
  sets         Set[]     // result sets (actual performance)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  createdById  String?          // who added it; nullable — backfilled from day.userId, no auth-derived creator yet
  source       String   @default("self")
  assignmentId String?          // unused until Phase C (ProgramAssignment)
  isRestDay    Boolean  @default(false)
}

model SessionType {
  key      String  @id          // immutable, matches SessionType union values in src/types/index.ts
  label    String
  color    String
  behavior String              // "sets" | "rounds" | "text"
  order    Int     @default(0)
  active   Boolean @default(true)
}

model Set {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  setNumber Int
  weight    Float?
  reps      Int?
  notes     String?
  createdAt DateTime @default(now())
}

model Recovery {
  id           String   @id @default(cuid())
  dayId        String   @unique
  day          Day      @relation(fields: [dayId], references: [id])
  energy       Int
  sore         String
  soreOther    String?
  sleepHours   Float?
  sleepQuality Int?
  notes        String?
  createdAt    DateTime @default(now())
}

model AISuggestion {
  id           String   @id @default(cuid())
  dayId        String   @unique
  day          Day      @relation(fields: [dayId], references: [id])
  summary      String
  perSession   String
  chips        String
  recoveryNote String?
  createdAt    DateTime @default(now())
}

model MaxRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  movement    String
  category    String   // "wl" | "workout" | "run"
  details     String?
  weight      Float?
  reps        Int?
  distance    Float?
  timeSeconds Int?
  notes       String?
  isExpected  Boolean  @default(false)
  date        String
  createdAt   DateTime @default(now())
}